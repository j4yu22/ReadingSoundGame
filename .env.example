# Local Docker Compose settings. Copy this file to .env and fill in real values.
# Do not commit the real .env file.

AZURE_SPEECH_KEY=replace-with-your-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaNeural
AZURE_SPEECH_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_STT_LANGUAGE=en-US
AZURE_STT_CORRECTNESS_THRESHOLD=65

# For local Docker testing you can use :80 and set HTTP_PORT=8080.
# For deployed microphone support, use a real domain here so Caddy can issue HTTPS.
SITE_ADDRESS=:80
ACME_EMAIL=
HTTP_PORT=8080
HTTPS_PORT=8443

# Account collection is disabled until the consent/privacy review is complete.
ACCOUNTS_ENABLED=false
ACCOUNT_REGISTRATION_OPEN=false
CHILD_DATA_COLLECTION_ENABLED=false
PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=
# Only localhost HTTP development may opt in; deployed cookies stay secure.
ALLOW_INSECURE_LOCALHOST=false

# Local PostgreSQL: docker compose -f compose.dev.yaml up -d
# Set this in src/api/.env when running run.ps1 on your computer:
# DATABASE_URL=postgresql+psycopg://reading_sound_dev:local-development-only@127.0.0.1:5432/reading_sound_game
# Do not point development at the production database.
DATABASE_URL=
DATABASE_IAM_AUTH=false
DATABASE_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem
AWS_REGION=us-west-2

# Confidential server-side Cognito client; never send this secret to the browser.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# Review these draft retention periods before enabling real student collection.
PRIVACY_CONTACT=gina_underwood@yahoo.com,jay.e.underwood@gmail.com
PRIVACY_NOTICE_VERSION=draft-2026-10-03
PRIVACY_NOTIFICATION_EMAILS=gina_underwood@yahoo.com,jay.e.underwood@gmail.com
PRIVACY_NOTIFICATION_FROM=
PROGRESS_RETENTION_DAYS=90
DELETION_LEDGER_DAYS=45
BACKUP_MAX_RETENTION_DAYS=35

# Once accounts are configured, set COMPOSE_PROFILES=accounts so deploy updates
# also start the deletion/notification worker and daily retention scheduler.
COMPOSE_PROFILES=
